<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:padding="24dp">
        <ImageView android:id="@+id/app_icon" android:layout_width="64dp" android:layout_height="64dp"
            android:importantForAccessibility="no" android:src="@mipmap/ic_app_icon" />
        <TextView android:id="@+id/step_text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:gravity="center" android:textSize="24sp" />
        <TextView android:id="@+id/hint_text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:gravity="center" android:textSize="16sp" />
        <RadioGroup android:id="@+id/storage_mode_options" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <RadioButton android:id="@+id/sync_from_external_option" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/sync_from_external" />
            <TextView android:id="@+id/sync_from_external_desc" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginStart="32dp"
                android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true"
                android:text="@string/sync_from_external_desc" android:textSize="14sp" />
            <RadioButton android:id="@+id/app_specific_storage_option" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/use_app_specific_storage" />
            <TextView android:id="@+id/app_specific_storage_desc" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginStart="32dp"
                android:clickable="true" android:focusable="true"
                android:text="@string/use_app_specific_storage_desc" android:textSize="14sp" />
        </RadioGroup>
        <LinearLayout android:id="@+id/input_options" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="16dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/setup__layout_label" android:textStyle="bold" />
            <RadioGroup android:id="@+id/input_layout_options" android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton android:id="@+id/keep_current_input_option" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/setup__keep_current" />
                <RadioButton android:id="@+id/full_pinyin_option" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/setup__full_pinyin" />
                <RadioButton android:id="@+id/nine_key_option" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/setup__nine_key" />
            </RadioGroup>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/setup__charset_label"
                android:textStyle="bold" />
            <RadioGroup android:id="@+id/charset_options" android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton android:id="@+id/simplified_option" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/setup__simplified" />
                <RadioButton android:id="@+id/traditional_option" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/setup__traditional" />
            </RadioGroup>
            <TextView android:id="@+id/input_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <LinearLayout android:id="@+id/trial_options" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="16dp" android:visibility="gone">
            <com.osfans.trime.ui.setup.SetupTrialEditText android:id="@+id/trial_input"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="96dp" android:gravity="top|start" android:inputType="textMultiLine"
                android:imeOptions="flagNoExtractUi|flagNoPersonalizedLearning"
                android:saveEnabled="false" android:hint="@string/setup__trial_hint" />
            <TextView android:id="@+id/trial_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/trial_later_button" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/setup__trial_later" />
        </LinearLayout>
        <Button android:id="@+id/action_button" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="24dp" />
        <FrameLayout android:id="@+id/done_row" android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <androidx.appcompat.widget.AppCompatTextView android:id="@+id/done_text" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/done"
                android:gravity="center_vertical" app:drawableStartCompat="@drawable/ic_baseline_check_circle_24"
                android:drawablePadding="8dp"
                android:textColor="?android:attr/colorAccent" android:textSize="20sp" android:textStyle="bold" />
        </FrameLayout>
        <Button android:id="@+id/advanced_button" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/setup__advanced" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
