<resources>
    <style name="Theme.TrimeAppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:colorAccent" >@color/colorAccent</item>
    </style>

    <style name="Theme.DialogTheme" parent="@android:style/Theme.DeviceDefault.Light.Dialog" />

    <!-- 跟随 Trime 主题（日间/夜间）的对话框主题：文字颜色随深浅色协调，背景色由代码按主题覆盖。 -->
    <style name="Theme.Dialog.Light" parent="Theme.AppCompat.Light.Dialog.Alert" />
    <style name="Theme.Dialog.Dark" parent="Theme.AppCompat.Dialog.Alert" />
</resources>
